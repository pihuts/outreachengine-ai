            "Name": "={{ $json.name }}",
            "Company": "={{ $json.company }}",
            "Website": "={{ $json.website }}",
            "Subject": "={{ $json.subject }}",
            "Body": "={{ $json.body }}",
            "Flag": "={{ $json.flag }}",
            "Reason": "={{ $json.reason }}",
            "Updated At": "={{ $json.generatedAt }}",
            "Status": "={{ $json.flag === 'ok' ? 'Draft created' : 'Needs human' }}"
          },
          "schema": [
            {
              "id": "Email",
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
