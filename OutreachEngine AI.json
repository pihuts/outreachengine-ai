    {
      "id": "preflight",
      "name": "Preflight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const env = $env;\nconst enabled = env.OUTREACH_ENABLED === 'true';\nconst dryRun = env.OUTREACH_DRY_RUN !== 'false';\nconst required = [\"COLD_EMAIL_SHEET_ID\", \"COLD_EMAIL_SENDER_NAME\", \"COLD_EMAIL_SENDER_COMPANY\", \"COLD_EMAIL_OFFER\", \"OUTREACH_ALERT_EMAIL_TO\"];\nif (enabled && !dryRun) {\n  const missing = required.filter(key => !String(env[key] || '').trim());\n  if (missing.length) throw new Error('Missing configuration: ' + missing.join(', '));\n}\nconst runId = String($execution.id);\nconst status = !enabled ? 'disabled' : dryRun ? 'dry_run' : 'running';\nconsole.log(JSON.stringify({timestamp: new Date().toISOString(), runId, workflow: 'OUTREACH', status}));\nconst first = $input.first();\nreturn [{json: {...first.json, runId, status, runLive: status === 'running'}, ...(first.binary ? {binary: first.binary} : {})}];"
      }
