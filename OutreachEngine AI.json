{
  "id": "c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f",
  "name": "OutreachEngine AI - Grounded Cold Email Drafts",
  "nodes": [
    {
      "id": "cold-sticky",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -400,
        -500
      ],
      "parameters": {
        "width": 820,
        "height": 240,
        "content": "## OutreachEngine AI\n\nReads leads from Google Sheets, fetches each lead's real website, and writes a personalized cold email grounded only in the scraped content. Creates Gmail drafts for human review and logs every attempt.\n\nIf the site is broken or too thin, the AI returns needs_human instead of inventing facts."
      },
      "typeVersion": 1
    },
    {
      "id": "cold-manual",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "cold-schedule",
      "name": "Weekly on Monday 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        240,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "cold-get-leads",
      "name": "Get Leads from Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        960,
        0
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $env.COLD_EMAIL_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
