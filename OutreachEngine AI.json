      "typeVersion": 4.5
    },
    {
      "id": "cold-limit",
      "name": "Limit 5 Leads per Run",
      "type": "n8n-nodes-base.limit",
      "position": [
        1440,
        0
      ],
      "parameters": {
        "maxItems": "={{ Number($env.OUTREACH_MAX_LEADS || 5) }}"
      },
      "typeVersion": 1
    },
    {
      "id": "cold-prepare",
      "name": "Prepare Lead",
      "type": "n8n-nodes-base.code",
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "return (() => {\nconst row = $json;\nconst email = row.Email || row.email || '';\nconst website = row.Website || row.website || row.URL || row.url || '';\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Valid lead email required');\nlet safeSite = false;\ntry {\n  const u = new URL(website);\n  const host = u.hostname.toLowerCase();\n  safeSite = u.protocol === 'https:' && !u.username && !u.password &&\n    !/^(localhost|127\\.|10\\.|192\\.168\\.|169\\.254\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|0\\.|::1|\\[::1\\])/.test(host) &&\n    !host.endsWith('.local') && !host.endsWith('.internal');\n} catch {}\nif (!safeSite) return [{json: {...row, skip: true, skipReason: 'Invalid or private website URL', email}}];\nreturn [{\n  json: {\n    name: row.Name || row.name || '',\n    email,\n    company: row.Company || row.company || '',\n    title: row.Title || row.title || '',\n    website,\n    offer: row.Offer || row.offer || $env.COLD_EMAIL_OFFER || 'We help companies save time with automation.',\n    senderName: $env.COLD_EMAIL_SENDER_NAME || 'Your Name',\n    senderCompany: $env.COLD_EMAIL_SENDER_COMPANY || 'Your Company',\n    skip: false\n  }\n}];\n})()[0];",
        "mode": "runOnceForEachItem"
      },
      "typeVersion": 2
    },
    {
      "id": "cold-fetch",
      "name": "Fetch Website",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2880,
        0
      ],
      "parameters": {
        "url": "={{ $json.website }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        },
        "continueOnFail": true,
        "retryOnFail": true,
        "maxTries": 2
      },
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "cold-clean",
      "name": "Clean Site Text",
      "type": "n8n-nodes-base.code",
      "position": [
        3360,
        0
      ],
      "parameters": {
        "jsCode": "return (() => {\nconst item = $json;\nlet text = '';\nif (item.data && typeof item.data === 'string') {\n  text = item.data;\n} else if (item.error) {\n  text = 'Fetch error: ' + String(item.error);\n} else {\n  text = JSON.stringify(item);\n}\ntext = String(text)\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 6000);\nconst words = text.split(/\\s+/).filter(Boolean).length;\nreturn [{ json: { ...$('Prepare Lead').item.json, ...item, siteText: text, siteWordCount: words, siteUsable: !item.error && words >= Number($env.OUTREACH_MIN_SITE_WORDS || 40) } }];\n})()[0];",
        "mode": "runOnceForEachItem"
      },
      "typeVersion": 2
    },
    {
      "id": "cold-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        3840,
        320
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.6-terra"
        },
        "options": {
          "temperature": 0.4,
          "timeout": 30000
